{
  "name": "trusteo",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "npm run dev -w @trusteo/web",
    "build": "npm run build -w @trusteo/web",
    "start": "npm run start -w @trusteo/web",
    "worker": "npm run start -w @trusteo/worker",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit -p apps/web/tsconfig.json && tsc --noEmit -p apps/worker/tsconfig.json",
    "db:generate": "npm run db:generate -w @trusteo/web",
    "db:push": "npm run db:push -w @trusteo/web",
    "db:migrate": "node --env-file=.env scripts/migrate.mjs",
    "providers:generate": "node packages/core/src/providers/generate-registry.mjs",
    "predev": "npm run providers:generate",
    "prebuild": "npm run providers:generate",
    "lovable:links": "node scripts/lovable-links.mjs",
    "db:migrate:deploy": "node scripts/migrate.mjs",
    "test:standalone": "node --env-file-if-exists=.env scripts/smoke-standalone.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/node": "^22.19.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5",
    "prisma": "6.19.3"
  },
  "dependencies": {
    "pg": "^8.20.0"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.0"
  }
}
