generator client {
  provider = "prisma-client-js"
  engineType = "client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String   @id @default(cuid())
  email          String   @unique
  passwordHash   String
  firstName      String
  lastName       String
  phone          String?
  notifyEmail    Boolean  @default(true)
  notifyPush     Boolean  @default(false)
  consentAt      DateTime
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  sessions       Session[]
  passwordResets PasswordReset[]
  subscription   Subscription?
  locations      Location[]
  contacts       Contact[]
  campaigns      Campaign[]
  notifications  Notification[]
  pushSubscriptions PushSubscription[]
  referrals      Referral[]
  redemptions    PromotionRedemption[]
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
  @@index([expiresAt])
}

model PasswordReset {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
}

model Subscription {
  id                   String    @id @default(cuid())
  userId               String    @unique
  plan                 String    @default("essential")
  interval             String    @default("month")
  status               String    @default("incomplete")
  stripeCustomerId     String?   @unique
  stripeSubscriptionId String?   @unique
  currentPeriodEnd     DateTime?
  trialEndsAt          DateTime?
  enterpriseLocationLimit Int?
  stripeEventCreated   Int @default(0)
  checkoutSessionId     String?
  checkoutExpiresAt     DateTime?
  trialUsed             Boolean @default(false)
  cancelAtPeriodEnd     Boolean @default(false)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Location {
  id          String   @id @default(cuid())
  userId      String
  name        String
  address     String
  city        String
  reviewUrl   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  connections ProviderConnection[]
  reviews     Review[]
  campaigns   Campaign[]
  @@index([userId])
}

model ProviderConnection {
  id           String    @id @default(cuid())
  locationId   String
  platform     String
  mode         String    @default("assisted")
  status       String    @default("pending")
  externalId   String?
  credentials  String?
  authMethod   String    @default("oauth")
  pendingPreview String?
  previewTokenHash String? @unique
  previewExpiresAt DateTime?
  testedAt     DateTime?
  confirmedAt  DateTime?
  inboxToken   String?   @unique
  lastSyncedAt DateTime?
  lastError    String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  location     Location  @relation(fields: [locationId], references: [id], onDelete: Cascade)
  reviews      Review[]
  syncLogs     SyncLog[]
  @@unique([locationId, platform])
  @@index([status, mode])
}

model Review {
  id           String    @id @default(cuid())
  connectionId String
  locationId   String
  externalId   String
  platform     String
  author       String
  rating       Float
  text         String
  language     String    @default("fr")
  publishedAt  DateTime
  sourceUrl    String?
  status       String    @default("pending")
  replyText    String?
  repliedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  connection   ProviderConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  location     Location  @relation(fields: [locationId], references: [id], onDelete: Cascade)
  drafts       ReplyDraft[]
  @@unique([connectionId, externalId])
  @@index([locationId, publishedAt])
}

model ReplyDraft {
  id            String   @id @default(cuid())
  reviewId      String
  tone          String
  text          String
  promptVersion String
  createdAt     DateTime @default(now())
  review        Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  @@index([reviewId])
}

model SyncLog {
  id           String   @id @default(cuid())
  connectionId String
  status       String
  fetched      Int      @default(0)
  error        String?
  startedAt    DateTime @default(now())
  completedAt  DateTime?
  connection   ProviderConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  @@index([connectionId, startedAt])
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
}

model Contact {
  id           String   @id @default(cuid())
  userId       String
  email        String
  name         String
  phone        String?
  consentAt    DateTime
  consentSource String
  unsubscribedAt DateTime?
  unsubscribeToken String @unique @default(cuid())
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  recipients   CampaignRecipient[]
  referrals    Referral[]
  redemptions   PromotionRedemption[]
  @@unique([userId, email])
}

model Campaign {
  id          String   @id @default(cuid())
  userId      String
  locationId  String
  name        String
  channel     String   @default("email")
  message     String
  offer       String?
  status      String   @default("draft")
  createdAt   DateTime @default(now())
  sentAt      DateTime?
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  location    Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  recipients  CampaignRecipient[]
  @@index([userId, createdAt])
}

model CampaignRecipient {
  id         String   @id @default(cuid())
  campaignId String
  contactId  String
  status     String   @default("pending")
  sentAt     DateTime?
  deliveryStartedAt DateTime?
  error      String?
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  contact    Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  @@unique([campaignId, contactId])
}

model Referral {
  id            String   @id @default(cuid())
  userId        String
  contactId     String
  code          String   @unique @default(cuid())
  referredEmail String?
  convertedAt   DateTime?
  purchaseReference String?
  createdAt     DateTime @default(now())
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  contact       Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  @@index([userId])
  @@unique([userId, purchaseReference])
}

model PromotionRedemption {
  id                String   @id @default(cuid())
  userId            String
  contactId         String
  code              String   @unique @default(cuid())
  purchaseReference String
  discountPercent   Int      @default(10)
  redeemedAt        DateTime?
  redeemedPurchaseReference String?
  expiresAt         DateTime
  createdAt         DateTime @default(now())
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  contact           Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  @@unique([userId, purchaseReference])
  @@unique([userId, contactId])
  @@unique([userId, redeemedPurchaseReference])
}

model WebhookEvent {
  id          String   @id
  provider    String
  type        String
  processedAt DateTime @default(now())
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  reviewId  String? @unique
  emailSentAt DateTime?
  pushSentAt DateTime?
  emailAttemptedAt DateTime?
  title     String
  body      String
  url       String?
  readAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, createdAt])
}

model RateLimit {
  key     String   @id
  count   Int
  resetAt DateTime
}

// Durable association receipt. No foreign key: payment evidence must survive account deletion.
model PaymentReceipt {
  id                   String @id @default(cuid())
  checkoutSessionId    String @unique
  paymentLinkId        String
  stripeCustomerId     String
  stripeSubscriptionId String @unique
  email                String
  plan                 String
  interval             String
  tokenHash            String @unique
  tokenEnvelope        String?
  expiresAt            DateTime
  emailedAt            DateTime?
  claimedUserId        String?
  claimedAt            DateTime?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  @@index([email, claimedAt])
}

// Retained even when the subscription event arrives before anonymous Checkout.
model DeferredStripeEvent {
  id                   String @id
  type                 String
  stripeSubscriptionId String
  stripeCustomerId     String
  checkoutSessionId    String?
  eventCreated         Int
  resolvedAt           DateTime?
  receivedAt           DateTime @default(now())
  @@index([stripeSubscriptionId, resolvedAt])
}

// Pseudonymous anti-trial evidence remains independent of User deletion.
model TrialUsage {
  id                   String @id @default(cuid())
  stripeSubscriptionId String @unique
  emailHash            String @unique
  cardHash             String @unique
  claimedAt            DateTime @default(now())
  expiresAt            DateTime
  @@index([expiresAt])
}
