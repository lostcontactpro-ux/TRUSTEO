{
  "name": "@trusteo/web",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "prisma generate && next build --webpack && node ../../scripts/prepare-standalone.mjs",
    "start": "node --env-file-if-exists=../../.env .next/standalone/apps/web/server.js",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "node --env-file=../../.env ../../scripts/migrate.mjs"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@prisma/adapter-pg": "^6.19.3",
    "@prisma/client": "^6.19.2",
    "@radix-ui/react-slot": "^1.2.4",
    "@tailwindcss/postcss": "^4.1.18",
    "@trusteo/core": "*",
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.69.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "ioredis": "^5.9.2",
    "jose": "^6.1.3",
    "lucide-react": "^0.563.0",
    "next": "^16.1.6",
    "next-intl": "^4.8.2",
    "openai": "^6.22.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "resend": "^6.9.2",
    "stripe": "^20.3.1",
    "tailwind-merge": "^3.4.0",
    "tailwindcss": "^4.1.18",
    "web-push": "^3.6.7",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/web-push": "^3.6.4"
  },
  "engines": {
    "node": "24.x"
  }
}
