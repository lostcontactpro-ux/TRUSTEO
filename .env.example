# Copy to .env at repository root. Never commit .env or real credentials.
# Values below are local development defaults only.
APP_URL=http://localhost:3000
APP_NAME=Trusteo
DATABASE_URL=postgresql://trusteo:trusteo_local_only@localhost:5432/trusteo
REDIS_URL=redis://localhost:6379

# Required for OAuth credentials/state. Generate: openssl rand -hex 32
# Preserve securely with backups: changing this key requires reconnecting providers.
CREDENTIAL_ENCRYPTION_KEY=

# Stripe: use test-mode keys while developing.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ESSENTIAL_MONTH=
STRIPE_PRICE_ESSENTIAL_YEAR=
STRIPE_PRICE_PRO_MONTH=
STRIPE_PRICE_PRO_YEAR=
# Optional: auto-created stable coupon otherwise. Must be 20%, repeating, 2 months.
STRIPE_INTRO_COUPON_ID=

# AI: reply drafts only, never fabricated customer reviews.
OPENAI_API_KEY=
# Cloud proxy binding alias (OPENAI_ names are reserved by the cloud platform).
TRUSTEO_OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Email sending + password reset + contact form.
RESEND_API_KEY=
EMAIL_FROM=Trusteo <bonjour@example.com>
CONTACT_EMAIL=

# Official providers. Redirect URI for both: APP_URL/api/connections/oauth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
TRUSTPILOT_CLIENT_ID=
TRUSTPILOT_CLIENT_SECRET=

# Optional inbound email gateway (not a native Resend webhook).
# Domain must route to your trusted DKIM/ARC-validating gateway.
INBOUND_EMAIL_DOMAIN=
# Generate independently: openssl rand -hex 32
INBOUND_WEBHOOK_SECRET=

# Optional web push. Generate: npx web-push generate-vapid-keys
# Both public-key variables must contain the same generated public key.
VAPID_PUBLIC_KEY=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# Optional Twilio SMS; consent + sender configuration required.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# Optional test controls. Use a dedicated database, never production.
E2E_DATABASE_URL=
E2E_BASE_URL=http://127.0.0.1:3100
# For an already-installed Chromium; omit to use Playwright's browser download.
PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH=
